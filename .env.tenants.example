# Multi-tenant config for the Slack MCP server.
# Copy to .env.tenants (gitignored) and fill in. One hosted server serves
# every tenant listed in SLACK_TENANTS, each under its own URL path prefix.

# Public HTTPS base for this server (no trailing slash). For local testing,
# the ngrok/cloudflared tunnel URL; in prod, the real hostname.
SLACK_EXTERNAL_URL=https://your-tunnel-or-host.example

# Local bind port (one process serves all tenants).
SLACK_MCP_PORT=8001

# Fernet key encrypting OAuth state (DCR registrations, MCP tokens, Slack
# user tokens) at rest. Required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing the key invalidates the database: delete it and users re-authenticate.
SLACK_MCP_ENCRYPTION_KEY=REPLACE

# Persistence backend (encrypted with the key above either way):
#  - Production: set SLACK_MCP_DATABASE_URL to a Postgres DSN (takes precedence).
#  - Local/single-instance: leave it unset to use the SQLite file below.
#SLACK_MCP_DATABASE_URL=postgresql://user:pass@host:5432/slackmcp
#
# SQLite file path (used only when SLACK_MCP_DATABASE_URL is unset; default
# ./data/slack-mcp.db). Set to an empty string (and no DATABASE_URL) to disable
# persistence (state lost on restart).
#SLACK_MCP_DB_PATH=./data/slack-mcp.db

# One Slack app per tenant. Each tenant is reachable at:
#   <SLACK_EXTERNAL_URL>/<id>/mcp
# and its Slack app's Redirect URL must be set to:
#   <SLACK_EXTERNAL_URL>/<id>/oauth2callback
#
# team_id (optional) pins the OAuth flow to a specific workspace so the
# operator lands in the right workspace instead of Slack's default picker.
# client_secret may be inlined, or use "client_secret_env" to reference an
# env var name instead of embedding the secret in this blob.
SLACK_TENANTS='[
  {"id":"duolingo","client_id":"REPLACE","client_secret":"REPLACE","team_id":"T_AAAAAAA"},
  {"id":"handshake","client_id":"REPLACE","client_secret":"REPLACE","team_id":"T_BBBBBBB"}
]'
